# TriajeIA — configuración de ejemplo.
# Copiar a .env y ajustar. Nunca commitear secretos reales.

APP_NAME=TriajeIA
# Clave de firma de sesión (demo). En un entorno real: valor aleatorio y secreto.
APP_SECRET_KEY=cambiar-en-produccion
DB_PATH=triaje.db
LOG_LEVEL=INFO
MODELS_DIR=artifacts/models
MAX_INTENTOS_LOGIN=5
BLOQUEO_LOGIN_MIN=15
SESSION_TIMEOUT_MIN=5
TOKEN_RECUPERACION_MIN=15
