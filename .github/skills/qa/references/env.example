# Plantilla de variables de entorno para QA
#
# Copiá este archivo como `.env.qa` (o `.env.test`) en la raíz del proyecto
# y completá ahí los valores reales. NUNCA subas credenciales reales al
# repositorio, y NUNCA escribas credenciales en texto plano dentro de un
# plan de pruebas, un runbook en Markdown, un archivo de spec, ni ningún
# archivo bajo la carpeta `references/` de este skill.
#
# `.env.qa` / `.env.test` deben estar listados en `.gitignore`.

# URL base del entorno bajo prueba
QA_BASE_URL=https://staging.example.com

# Usuario de prueba estándar (sin privilegios). Si dejás email/password
# vacíos, correr `node scripts/ensure-test-user.mjs --role user` antes de
# ejecutar las pruebas: genera credenciales seguras nuevas y, si hay
# QA_SEED_API_URL configurado, crea la cuenta automáticamente vía API; si
# no, te da los datos exactos para crearla por el flujo real de signup.
QA_USER_EMAIL=qa.user@example.com
QA_USER_PASSWORD=

# Usuario de prueba admin/privilegiado (solo si el runbook lo requiere).
# Mismo mecanismo: `node scripts/ensure-test-user.mjs --role admin`.
QA_ADMIN_EMAIL=qa.admin@example.com
QA_ADMIN_PASSWORD=

# Opcional: token de API para sembrar/resetear datos de prueba vía API en vez de UI
QA_API_TOKEN=

# Opcional: endpoint propio del proyecto para crear usuarios de prueba por
# API (usado por scripts/ensure-test-user.mjs). Si no está seteado, el
# script pide crear la cuenta manualmente por el signup real de la app.
QA_SEED_API_URL=
QA_SEED_API_TOKEN=

# Opcional: dominio a usar cuando scripts/ensure-test-user.mjs genera un
# email de prueba nuevo (ej. qa.<random>@<este dominio>). Usá un dominio
# que vos controlás o que el proyecto ya usa para cuentas de prueba, nunca
# un dominio de terceros.
QA_TEST_EMAIL_DOMAIN=example.com

# Opcional: milisegundos de slowMo aplicados a cada acción de Playwright
# (ver scripts/playwright.config.template.ts). Sin esto, el video grabado
# muestra los clics tan rápido que no se alcanza a ver qué se probó.
# 250-400 es un buen punto de partida para videos legibles; poné 0 para
# ejecuciones de CI puramente funcionales donde nadie va a mirar el video.
QA_SLOWMO_MS=300

# Opcional: identificador de ejecución usado por scripts/organize-evidence.mjs
# para agrupar los artefactos de una sola ejecución. Dejalo vacío para que
# se autogenere uno (timestamp UTC) en el momento de ejecutar.
QA_RUN_ID=
